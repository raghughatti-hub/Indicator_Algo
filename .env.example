# Copy this file to .env and fill in your credentials
# Active broker selection: zebu, flattrade, or upstox
ACTIVE_BROKER=zebu

# Zebu (Shoonya) Credentials
ZEBU_CLIENT_ID=
ZEBU_API_SECRET=
ZEBU_USER_ID=
ZEBU_PASSWORD=
ZEBU_TOTP_SECRET=
ZEBU_REDIRECT_URL=
ZEBU_ACCESS_TOKEN=

# FlatTrade Credentials
FLATTRADE_USER_ID=
FLATTRADE_PASSWORD=
FLATTRADE_TOTP_SECRET=
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
FLATTRADE_REDIRECT_URL=
FLATTRADE_ACCESS_TOKEN=
FLATTRADE_SUSER_TOKEN=

# Upstox Credentials
UPSTOX_USER_ID=
UPSTOX_PASSWORD=
UPSTOX_PIN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_TOTP_SECRET=
UPSTOX_REDIRECT_URL=
UPSTOX_MOBILE=
UPSTOX_ACCESS_TOKEN=

# General Settings
LIVE_TRADING_ENABLED=false
DEFAULT_PRODUCT_TYPE=M
DEFAULT_EXCHANGE=NSE
DEFAULT_QUANTITY=1
